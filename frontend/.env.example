# Desarrollo local. Copiar a .env.local si se necesita otro backend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/
# Producción con proxy en el mismo origen: VITE_API_BASE_URL=/api/
# API en otro origen: VITE_API_BASE_URL=https://api.su-dominio.example/api/
# Se incorpora al compilar; cambiarla requiere volver a ejecutar npm run build.
# Ninguna variable VITE_* debe contener secretos.

# Vercel: Root Directory=frontend, install=npm ci, build=npm run build, output=dist.
# Definir en Vercel para Production; configurar Preview por separado.
# VITE_API_BASE_URL=https://api.su-dominio.example/api/
# Sin variable, produccion usa /api/ en Vercel y requiere proxy.
# vercel.json solo resuelve navegacion SPA; no reenvia la API.
# Autorizar origen HTTPS exacto de Vercel en CORS_ALLOWED_ORIGINS del backend.
# Node compatible: ^22.18.0 || >=24.11.0 (tambien declarado en package.json).
