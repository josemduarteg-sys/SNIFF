# Copiar a .env. Valores de desarrollo; NO usar este ejemplo sin ajustar en producción.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_NAME=sniff_db
DB_USER=sniff_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DB_SSLMODE=verify-full

# Listas separadas por comas. Orígenes con esquema, sin ruta ni barra final.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
DRF_NUM_PROXIES=0

# En HTTPS institucional: activar las tres opciones.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Solo detrás de un proxy confiable que reescriba X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
# HSTS es opcional durante puesta en marcha; activar después de validar HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Rutas relativas a backend, o rutas absolutas del servidor.
STATIC_ROOT=staticfiles
STATIC_URL=/static/
MEDIA_ROOT=media
MEDIA_URL=/media/

LIMITE_LOGIN_IP=20/minute
LIMITE_LOGIN_USUARIO=5/minute
LIMITE_RESTABLECIMIENTO_IP=10/hour
LIMITE_RESTABLECIMIENTO_IDENTIFICADOR=3/hour
