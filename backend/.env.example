# Copiar a .env. Valores de desarrollo; NO usar este ejemplo sin ajustar en producción.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_NAME=sniff_db
DB_USER=sniff_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DB_SSLMODE=verify-full

# Listas separadas por comas. Orígenes con esquema, sin ruta ni barra final.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
DRF_NUM_PROXIES=0

# En HTTPS institucional: activar las tres opciones.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Solo detrás de un proxy confiable que reescriba X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
# HSTS es opcional durante puesta en marcha; activar después de validar HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Rutas relativas a backend, o rutas absolutas del servidor.
STATIC_ROOT=staticfiles
STATIC_URL=/static/
MEDIA_ROOT=media
MEDIA_URL=/media/

LIMITE_LOGIN_IP=20/minute
LIMITE_LOGIN_USUARIO=5/minute
LIMITE_RESTABLECIMIENTO_IP=10/hour
LIMITE_RESTABLECIMIENTO_IDENTIFICADOR=3/hour

# Produccion Oracle + Neon: crear un entorno EXCLUSIVO del servidor.
# No modificar el .env local ni versionar credenciales.
# Variables exportadas tienen prioridad sobre .env.
# SNIFF_LOAD_DOTENV=False evita cargar backend/.env (usar EnvironmentFile del servicio).
# DATABASE_URL tiene prioridad sobre DB_*; vacia conserva DB_*.
DATABASE_URL=
# Usar URL DIRECTA de Neon (sin -pooler): las tareas usan advisory locks de sesion.
# Conservar parametros sslmode=require y channel_binding si corresponde.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA_CODIFICADA@HOST_NEON/BASE?sslmode=require
# Codificar caracteres especiales del usuario/contrasena en la URL.
# sslmode de la URL tiene prioridad; si falta, usa DB_SSLMODE o require.
# verify-full requiere certificados de confianza configurados en el servidor.
# Perfil HTTPS: reemplazar dominios de ejemplo por los definitivos.
# SECRET_KEY=<clave aleatoria exclusiva del servidor>
# DEBUG=False
# ALLOWED_HOSTS=api.su-dominio.example
# CORS_ALLOWED_ORIGINS=https://su-proyecto.vercel.app
# CSRF_TRUSTED_ORIGINS=https://api.su-dominio.example,https://su-proyecto.vercel.app
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# TRUST_X_FORWARDED_PROTO=True
# DRF_NUM_PROXIES=1
# USE_X_FORWARDED_HOST=False
# Confiar cabeceras solo detras de Nginx que las reescriba; Gunicorn en loopback.
# Activar HSTS despues de validar TLS; revisar subdominios/preload por separado.
# SECURE_HSTS_SECONDS=31536000
# MEDIA_ROOT=/var/lib/sniff/media
# STATIC_ROOT=/var/lib/sniff/staticfiles
# Media debe ser persistente y privada; no servir /media/ publicamente.
# Cache de limites por proceso: usar un worker hasta tener cache compartida.
# Linux, desde backend (Gunicorn se instala solo fuera de Windows):
# gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 1 --access-logfile - --error-logfile -
# Pendientes: servicio supervisado, proxy HTTPS, collectstatic y respaldos.
